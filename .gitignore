# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Saved Terraform plans
*.tfplan

# Real Terraform variable values
*.tfvars
*.tfvars.json

# Safe example files can be versioned
!*.tfvars.example
!*.tfvars.json.example

# Real backend configuration
backend.*.hcl
!backend.*.hcl.example

# Environment files and credentials
.env
.env.*
*.pem
*.key

# Crash logs
crash.log
crash.*.log

# Python generated files
__pycache__/
*.pyc

# Local Azure CLI and Docker credentials
.azure/
.docker/

# Certificate and private-key bundles
*.pfx
*.p12
